+/* frame-chip.module.css — the three frame mini-previews.
+ *
+ * Ported from the 7.21 handoff's FramePicker swatches
+ * (source-home/settings.css:93-117). The handoff renders a small 1.5:1 tile per
+ * frame containing two stacked "cards", each frame styling them to advertise its
+ * own material:
+ *
+ *   .set-frame-pv{position:relative;width:100%;aspect-ratio:1.5/1;border-radius:11px;
+ *     overflow:hidden;display:flex;flex-direction:column;justify-content:center;
+ *     gap:5px;padding:11px 12px;background:linear-gradient(135deg,#5b6b8c,#2d3550)}
+ *   .set-frame-pv .pv-card{height:9px;border-radius:4px}
+ *   .pv-card.a{width:80%}  .pv-card.b{width:55%}
+ *
+ * Our picker is a compact radio row rather than the handoff's card grid, so the
+ * tile is scaled down to sit beside a RadioDot in the same slot ThemeChip
+ * occupies. The RECIPES are the handoff's; only the box size changes.
+ *
+ * Why this file exists at all: our frame picker had NO preview of any kind —
+ * `renderPreview` was passed only by the theme group, so the three frame options
+ * were bare text. The handoff has always specified swatches here.
+ */
+
+.chip {
+  position: relative;
+  width: 34px;
+  aspect-ratio: 1.5 / 1;
+  /* RULE #1 — no sharp corners. 11px in the handoff; --r-sm is 10px, the
+     nearest token, and the 1px is imperceptible at 34px wide. */
+  border-radius: var(--r-sm);
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 2.5px;
+  padding: 5px 6px;
+  flex: none;
+  /* The handoff's default tile ground (a dusk blue-slate), used by pv-A. */
+  background: linear-gradient(135deg, #5b6b8c, #2d3550);
+}
+
+.card {
+  height: 4.5px;
+  border-radius: 2px;
+}
+.a {
+  width: 80%;
+}
+.b {
+  width: 55%;
+}
+
+/* ── A · Calm Glass — frosted floating cards on a photo-ish ground (:101-103) ──
+   The inset top highlight is the lit-edge read that CLAUDE.md §4 calls the
+   signature of glass; it is what distinguishes this swatch from plain white. */
+.glass .card {
+  background: rgba(255, 255, 255, 0.5);
+  -webkit-backdrop-filter: blur(4px);
+  backdrop-filter: blur(4px);
+  border: 1px solid rgba(255, 255, 255, 0.6);
+  box-shadow:
+    0 4px 10px -4px rgba(0, 0, 0, 0.5),
+    inset 0 1px 0 rgba(255, 255, 255, 0.8);
+  border-left: 2px solid var(--subj-10);
+}
+
+/* ── B · Bright — white paper on a warm surface (:105-107) ─────────────────── */
+.paper {
+  background: #ecebe4;
+}
+.paper .card {
+  background: #fff;
+  border: 1px solid rgba(28, 27, 46, 0.1);
+  border-left: 2px solid var(--subj-10);
+  box-shadow: var(--sh-xs);
+}
+
+/* ── C · Pastel — soft subject tints on a pale wash (:109-112) ──────────────
+   ⚠ THE `pv-C` RECIPE IS THE ONE PLACE THE HANDOFF CONTRADICTS ITSELF, and the
+   contradiction is resolved here deliberately.
+
+   settings.css:109-112 still carries the OLD Frame-C swatch, from when Frame C
+   was "Color-forward": a lilac/mint ground (#F4F1F6→#EEF6F2) with two SATURATED
+   subject gradients. That is the swatch for a frame that no longer exists —
+   settings.jsx:80 in the SAME handoff renames C to "Pastel · Soft tints · Common
+   Planner", and pastel-frame.css paints a cool-gray canvas (#f1f5f9) with WHITE
+   cards and subject tints mixed 22% toward white.
+
+   A swatch is a promise about what picking the option does. Shipping the old
+   recipe would have shown a teacher lilac-and-mint saturation and then handed
+   them a gray-and-white planner. So the swatch follows pastel-frame.css — the
+   newer, more specific file, and the one that actually defines the frame — while
+   keeping the handoff's STRUCTURE (a pale ground, two subject-tinted cards).
+   Ground and card fills are taken from the Pastel token tier so the swatch
+   cannot drift from the frame it advertises. */
+.pastel {
