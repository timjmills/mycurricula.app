@@ -0,0 +1,40 @@
+"use client";
+
+// frame-chip.tsx — the mini-preview swatch for each frame option.
+//
+// The 7.21 handoff's FramePicker (source-home/settings.jsx:76-95) renders a
+// visual mini-preview of each frame's CHARACTER beside its label — two stacked
+// "cards" on a ground, styled per frame. Our frame picker shipped without any
+// preview at all (`renderPreview` was passed only by the Theme group), so the
+// three frames were bare text and a teacher had no way to tell what "Pastel"
+// would look like before choosing it.
+//
+// Shape mirrors ThemeChip (components/appearance/theme-picker.tsx) so it drops
+// into the same `renderPreview` slot with no layout change. All colour lives in
+// frame-chip.module.css, which carries the handoff citations — including a note
+// on the one place the handoff contradicts itself about the Frame C swatch.
+
+import type { ReactNode } from "react";
+import type { ThemeFrame } from "@/lib/theme";
+import styles from "./frame-chip.module.css";
+
+// Frame value → the module class carrying that frame's recipe. Keyed by the
+// axis VALUE (unchanged by the Pastel rename — Frame C is still `color`), with
+// the class named for the LOOK, so the file reads as what it draws.
+const FRAME_CLASS: Record<ThemeFrame, string> = {
+  glass: styles.glass,
+  paper: styles.paper,
+  color: styles.pastel,
+};
+
+export function FrameChip({ id }: { id: ThemeFrame }): ReactNode {
+  return (
+    // aria-hidden: the swatch is decorative. The option's real accessible name
+    // comes from the label + tooltip on the surrounding radio, so announcing
+    // this would only add noise.
+    <span className={`${styles.chip} ${FRAME_CLASS[id]}`} aria-hidden="true">
+      <span className={`${styles.card} ${styles.a}`} />
+      <span className={`${styles.card} ${styles.b}`} />
+    </span>
+  );
+}
