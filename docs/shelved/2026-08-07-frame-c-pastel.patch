+/* pastel-theme-lock.module.css
+ *
+ * The Frame C · Pastel theme locked-note. Ported from the 7.21 handoff's
+ * `.set-lockednote` (source-home/settings.css:83):
+ *
+ *   .set-lockednote{font:600 12px var(--font-sans);color:var(--muted);
+ *     line-height:1.55;border:1px dashed var(--border);border-radius:12px;
+ *     padding:11px 13px;background:var(--surface-warm,#fafafa)}
+ *
+ * Kept token-for-token — the handoff already expresses this rule entirely in
+ * custom properties we also carry, so nothing had to be re-derived and no hex
+ * appears here. Under Pastel those tokens resolve to the tier in app/tokens.css
+ * (--muted #52525c, --border #e4e4e7, --surface-warm #fafafa), which is exactly
+ * the appearance the handoff's literal fallback describes.
+ *
+ * The dashed border is doing real work: it reads as "inert / not a control",
+ * distinguishing the note from the solid-bordered option cards it replaces.
+ */
+
+.lockedNote {
+  font-family: var(--font-sans);
+  font-size: 12px;
+  font-weight: 600;
+  line-height: 1.55;
+  color: var(--muted);
+  border: 1px dashed var(--border);
+  /* RULE #1 — no sharp corners. The handoff's literal is 12px; our scale's
+     --r-lg is 18px, so the exact-value token is --r-12. (Checked rather than
+     assumed — the semantic name would have been 6px off.) */
+  border-radius: var(--r-12);
+  padding: 11px 13px;
+  background: var(--surface-warm);
+  margin-top: 12px;
+}
