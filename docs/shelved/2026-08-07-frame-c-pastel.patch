index 0000000..b605844
--- /dev/null
+++ b/tests/theme-tone-lockstep.test.ts
@@ -0,0 +1,372 @@
+// tests/theme-tone-lockstep.test.ts
+//
+// ALLOWLIST LOCKSTEP — the tone derivation, pinned across all three copies.
+// ─────────────────────────────────────────────────────────────────────────────
+// `data-tone` is DERIVED, and the rule that derives it exists in THREE places:
+//
+//   1. lib/theme-values.ts  `deriveTone()`      — the canonical implementation,
+//                                                 used by the client provider
+//                                                 (lib/theme.tsx).
+//   2. lib/theme-init.tsx   the inline boot script — a hand-kept JS replica that
+//                                                 CANNOT import the canonical
+//                                                 one (it runs before any module
+//                                                 loads) and paints <html> before
+//                                                 first paint.
+//   3. app/layout.tsx       the SSR attribute    — calls (1), but has to pass it
+//                                                 the right axes.
+//
+// If (1) and (2) drift, the symptom is a FIRST-PAINT FLASH: the server/boot
+// paints one tone, the provider corrects it a frame later. No ordinary unit test
+// catches that, because each copy is individually self-consistent. This file
+// catches it by running BOTH implementations over the full axis cross-product
+// and asserting they agree on every one of the 252 combinations.
+//
+// The boot script is not exported as a string, so rather than re-typing it (which
+// would test a copy of a copy) this file RENDERS <ThemeInit /> with
+// react-dom/server and executes the real emitted <script> body against stubbed
+// browser globals. What is asserted is therefore what actually ships.
+//
+// Added by the Frame C · Pastel port, which introduced rule 0 (frame === "color"
+// → light). That rule is why the frame axis now participates in the derivation
+// at all, and it is the one most likely to be missed by a future edit to one
+// copy — hence the cross-product rather than a handful of examples.
+
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { renderToStaticMarkup } from "react-dom/server";
+import { createElement } from "react";
+
+import {
+  deriveTone,
+  APP_THEMES,
+  FRAME_VALUES,
+  GLASS_VALUES,
+  BG_VALUES,
+  DIM_VALUES,
+  type AppTheme,
+  type ThemeFrame,
+  type ThemeGlass,
+  type ThemeBg,
+  type ThemeDim,
+  type ThemeTone,
+} from "@/lib/theme-values";
+import { ThemeInit } from "@/lib/theme-init";
+
+// ── Extract the REAL boot script from the REAL component ─────────────────────
+
+const BOOT_HTML = renderToStaticMarkup(createElement(ThemeInit));
+
+/** The script body as it is emitted into the HTML payload. */
+const BOOT_SCRIPT = (() => {
+  const m = BOOT_HTML.match(/<script[^>]*>([\s\S]*)<\/script>/);
+  if (!m) throw new Error("ThemeInit did not render a <script> element");
+  return m[1];
+})();
+
+// Guard: if the extraction silently produced something inert, every "agreement"
+// assertion below would pass vacuously (the stub's tone would stay undefined and
+// so would the expectation if we were careless). Prove the script is real and
+// that it is the tone-deriving one before trusting a single result.
+describe("boot-script extraction (the instrument itself)", () => {
+  it("extracted a non-trivial script that derives tone", () => {
+    expect(BOOT_SCRIPT.length).toBeGreaterThan(400);
+    expect(BOOT_SCRIPT).toContain("dataset.tone");
+    // HTML-escaping would break execution; react escapes `<` in text children
+    // but NOT inside dangerouslySetInnerHTML. Pin that, since a future switch to
+    // a text child would silently produce a script full of &lt; that still
+    // "extracts" fine and then throws — or worse, no-ops inside its try/catch.
+    expect(BOOT_SCRIPT).not.toContain("&lt;");
+    expect(BOOT_SCRIPT).not.toContain("&amp;&amp;");
+  });
+});
+
+// ── A minimal browser stub the boot script can run against ───────────────────
+
+const KEY = {
+  theme: "mycurricula:user:theme",
+  frame: "mycurricula:user:theme-frame",
+  style: "mycurricula:user:theme-style",
+  glass: "mycurricula:user:theme-glass",
+  bg: "mycurricula:user:theme-bg",
+  dim: "mycurricula:user:theme-dim",
+};
+
+interface BootResult {
+  theme?: string;
+  frame?: string;
+  glass?: string;
+  bg?: string;
+  dim?: string;
+  tone?: string;
+}
+
+/**
+ * Execute the shipped boot script with the given persisted axes and return the
+ * dataset it painted. The script is wrapped in its own try/catch, so a thrown
+ * reference error would be swallowed and leave `tone` undefined — which is why
+ * every caller asserts on a CONCRETE tone value rather than on equality alone.
+ */
+function runBootScript(axes: {
+  theme: string;
+  frame: string;
+  glass: string;
+  bg: string;
+  dim: string;
+}): BootResult {
+  const store = new Map<string, string>([
+    [KEY.theme, axes.theme],
+    [KEY.frame, axes.frame],
+    [KEY.glass, axes.glass],
+    [KEY.bg, axes.bg],
+    [KEY.dim, axes.dim],
+  ]);
+
+  const dataset: BootResult = {};
+  const documentStub = { documentElement: { dataset } };
+  const localStorageStub = {
+    getItem: (k: string) => (store.has(k) ? store.get(k)! : null),
+    setItem: (k: string, v: string) => void store.set(k, v),
+  };
+  // The script only consults matchMedia for theme === "system", which is not in
+  // APP_THEMES and so never reached here; stubbed for completeness.
+  const matchMediaStub = () => ({ matches: false });
+
+  // `new Function` is deliberate and safe HERE, and only here: BOOT_SCRIPT is
+  // not input of any kind — it is our own first-party source, read out of the
+  // component that ships it, in a test-only file that never runs in the app or
+  // in production. Executing the real string is the entire point: re-typing the
+  // script into the test would test a copy of a copy and could not detect the
+  // drift this file exists to catch. Nothing user-supplied is interpolated into
+  // the body, and the three stubbed globals are the script's only capabilities.
+  // eslint-disable-next-line no-new-func
+  const fn = new Function(
+    "document",
+    "localStorage",
+    "matchMedia",
+    BOOT_SCRIPT,
+  );
+  fn(documentStub, localStorageStub, matchMediaStub);
+  return dataset;
+}
+
+// Prove the harness can actually observe a tone before any agreement claim is
+// made. A stub that silently no-ops would make every cross-product assertion
+// pass while testing nothing — the "absence-assertions fail open" trap.
+describe("boot-script harness (Gate B — a known-good control)", () => {
+  it("paints a concrete tone for a known case", () => {
+    const out = runBootScript({
+      theme: "night",
+      frame: "glass",
+      glass: "dark",
+      bg: "photo",
+      dim: "normal",
+    });
+    expect(out.tone).toBe("dark");
+    expect(out.theme).toBe("night");
+    expect(out.frame).toBe("glass");
+  });
+
+  it("observes a DIFFERENT tone for a case that should differ", () => {
+    // If the harness were inert, both this and the case above would return the
+    // same (or undefined) value. They must differ.
+    const out = runBootScript({
+      theme: "clear",
+      frame: "glass",
+      glass: "light",
+      bg: "photo",
+      dim: "normal",
+    });
+    expect(out.tone).toBe("light");
+  });
+});
+
+// ── The cross-product ────────────────────────────────────────────────────────
+
+const CROSS: {
+  frame: ThemeFrame;
+  theme: AppTheme;
+  glass: ThemeGlass;
+  bg: ThemeBg;
+  dim: ThemeDim;
+}[] = [];
+for (const frame of FRAME_VALUES)
+  for (const theme of APP_THEMES)
+    for (const glass of GLASS_VALUES)
+      for (const bg of BG_VALUES)
+        for (const dim of DIM_VALUES)
+          CROSS.push({ frame, theme, glass, bg, dim });
+
+describe("deriveTone × boot script — full axis cross-product", () => {
+  it("covers every combination (3 × 7 × 2 × 2 × 3 = 252)", () => {
+    expect(CROSS).toHaveLength(
+      FRAME_VALUES.length *
+        APP_THEMES.length *
+        GLASS_VALUES.length *
+        BG_VALUES.length *
+        DIM_VALUES.length,
+    );
+    expect(CROSS).toHaveLength(252);
+  });
+
+  it("the boot script agrees with deriveTone on EVERY combination", () => {
+    const mismatches: string[] = [];
+    for (const c of CROSS) {
+      // autoTone=null — the boot script has no photo sample available either, so
+      // this is the like-for-like comparison. The provider's later AUTO upgrade
+      // is a deliberate, post-mount reconciliation, not a lockstep violation.
+      const canonical = deriveTone(
+        c.theme,
+        c.glass,
+        c.bg,
+        c.dim,
+        null,
+        c.frame,
+      );
+      const boot = runBootScript(c).tone;
+      // A concrete tone, not undefined — an exception swallowed by the script's
+      // own try/catch must fail this test rather than pass it silently.
+      if (boot !== "light" && boot !== "dark") {
+        mismatches.push(
+          `${c.frame}/${c.theme}/${c.glass}/${c.bg}/${c.dim}: boot produced no tone (${String(boot)})`,
+        );
+        continue;
+      }
+      if (boot !== canonical) {
+        mismatches.push(
+          `${c.frame}/${c.theme}/${c.glass}/${c.bg}/${c.dim}: deriveTone=${canonical} boot=${boot}`,
+        );
+      }
+    }
+    expect(mismatches).toEqual([]);
+  });
+});
+
+// ── Rule 0 — the Pastel contract ─────────────────────────────────────────────
+
+describe("rule 0 — Frame C · Pastel is always light", () => {
+  it("derives light for EVERY axis combination under frame=color", () => {
+    const bad: string[] = [];
+    for (const c of CROSS.filter((x) => x.frame === "color")) {
+      const t: ThemeTone = deriveTone(
+        c.theme,
+        c.glass,
+        c.bg,
+        c.dim,
+        // Even a sampled dark autoTone must not win — rule 0 short-circuits
+        // before the AUTO branch is ever consulted.
+        "dark",
+        c.frame,
+      );
+      if (t !== "light")
+        bad.push(`${c.theme}/${c.glass}/${c.bg}/${c.dim} → ${t}`);
+    }
+    expect(bad).toEqual([]);
+  });
+
+  it("the boot script also forces light under frame=color", () => {
+    const bad: string[] = [];
+    for (const c of CROSS.filter((x) => x.frame === "color")) {
+      const out = runBootScript(c);
+      if (out.tone !== "light")
+        bad.push(`${c.theme}/${c.glass}/${c.bg}/${c.dim} → ${String(out.tone)}`);
+    }
+    expect(bad).toEqual([]);
+  });
+
+  it("does NOT regress glass or paper — their tone is unchanged", () => {
+    // The pre-Pastel derivation, transcribed independently of the implementation
+    // so this is a genuine oracle rather than a restatement. If someone widens
+    // rule 0 (say, to `frame !== "glass"`), this goes red.
+    const legacy = (
+      theme: AppTheme,
+      glass: ThemeGlass,
+      bg: ThemeBg,
+      dim: ThemeDim,
+    ): ThemeTone => {
+      if (theme === "night") return "dark";
+      if (glass === "light") return "light";
+      if (bg === "wash") return "light";
+      if (dim === "dim") return "dark";
+      if (dim === "bright") return "light";
+      return "dark";
+    };
+    const bad: string[] = [];
+    for (const c of CROSS.filter((x) => x.frame !== "color")) {
+      const now = deriveTone(c.theme, c.glass, c.bg, c.dim, null, c.frame);
+      const before = legacy(c.theme, c.glass, c.bg, c.dim);
+      if (now !== before)
+        bad.push(
+          `${c.frame}/${c.theme}/${c.glass}/${c.bg}/${c.dim}: was ${before}, now ${now}`,
+        );
+    }
+    expect(bad).toEqual([]);
+  });
+
+  it("the hazard case is fixed: persisted Night + Pastel renders light", () => {
+    // This is the concrete illegibility the port had to resolve — a teacher who
+    // had chosen Night, then switched to Pastel. Before rule 0 this derived
+    // "dark", and app/themes.css's colour·Night rules painted near-black panels
+    // under the Pastel tier's near-black ink.
+    expect(deriveTone("night", "dark", "photo", "dim", "dark", "color")).toBe(
+      "light",
+    );
+    expect(
+      runBootScript({
+        theme: "night",
+        frame: "color",
+        glass: "dark",
+        bg: "photo",
+        dim: "dim",
+      }).tone,
+    ).toBe("light");
+  });
+});
+
+// ── Surface 3 of the lockstep — the SSR attribute ────────────────────────────
+
+describe("app/layout.tsx passes the frame axis to deriveTone", () => {
+  // tsc already guarantees SIX arguments are passed (the parameter is required
+  // and deliberately not defaulted). What it cannot catch is passing the WRONG
+  // sixth argument — a literal, or the wrong axis — which would make SSR derive
+  // a different tone from the boot script and flash on every load.
+  const LAYOUT = readFileSync(
+    fileURLToPath(new URL("../app/layout.tsx", import.meta.url)),
+    "utf8",
+  );
+
+  it("calls deriveTone with axes.frame, not a literal", () => {
+    const call = LAYOUT.match(/deriveTone\(([\s\S]*?)\)/);
+    expect(call).not.toBeNull();
+    const args = call![1];
+    expect(args).toContain("axes.frame");
+    expect(args).not.toMatch(/"(glass|paper|color)"/);
+  });
+});
+
+// ── Surface 5 of the lockstep — the probe ────────────────────────────────────
+
+describe("scripts/probe-theme-wave.mjs knows Pastel is always light", () => {
+  const PROBE = readFileSync(
+    fileURLToPath(
+      new URL("../scripts/probe-theme-wave.mjs", import.meta.url),
+    ),
+    "utf8",
+  );
+
+  it("no colour-frame corner still claims to exercise a theme wash", () => {
+    // The corners named `color-photo` / `color-wash` used to seed theme
+    // "blossom" / "mint". Under Pastel the theme is locked away, so those seeds
+    // no longer test what their names say. The port re-seeds them; this pins
+    // that they are not silently reverted to a themed seed.
+    const corner = PROBE.match(/const CORNER_CASES = \[([\s\S]*?)\];/);
+    expect(corner).not.toBeNull();
+    const colourRows = corner![1]
+      .split("\n")
+      .filter((l) => l.includes('frame: "color"'));
+    expect(colourRows.length).toBeGreaterThan(0);
+    for (const row of colourRows) {
+      expect(row).not.toMatch(/theme: "(blossom|mint|honey|sky|night)"/);
+    }
+  });
+});
