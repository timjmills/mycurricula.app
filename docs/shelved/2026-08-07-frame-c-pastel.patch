+// pastel-theme-lock.tsx — the Frame C · Pastel theme locked-note.
+//
+// Frame C is PASTEL (the 7.21 handoff's "Common Planner" skin), and Pastel LOCKS
+// ITS OWN PALETTE: a cool-gray canvas with teal accents, self-coloured, with the
+// theme wash and tint neutralised (app/themes.css) and the tone forced light
+// (lib/theme-values.ts deriveTone rule 0).
+//
+// The handoff does not merely DISABLE the 7-theme picker under this frame — it
+// REPLACES it with an explanatory note (source-home/settings.jsx:185-187):
+//
+//     {t.version==='C'
+//       ? <div className="set-lockednote">Pastel locks its own palette — cool
+//         gray canvas, teal accents. Switch to Calm Glass or Bright to use
+//         themes.</div>
+//       : <ThemePicker value={t.theme} onChange={v=>setTweak('theme',v)} />}
+//
+// Replacement rather than a disabled control is the right call on its own terms:
+// a greyed-out grid of seven swatches invites a teacher to keep clicking and
+// tells them nothing, whereas the note explains the cause AND the remedy. The
+// copy below is the handoff's, verbatim.
+//
+// Styling follows the handoff's `.set-lockednote` recipe (settings.css:83) —
+// dashed hairline border, rounded, muted 12px semibold text on the warm surface
+// — expressed in our tokens rather than its literals, per CLAUDE.md §4.
+//
+// Rendered by BOTH theme-picker.tsx and appearance-controls.tsx, which are two
+// separate theme choosers mounted on three surfaces (/settings/appearance mounts
+// both). Locking lives here, once, so the two cannot drift.
+
+import type { ReactNode } from "react";
+import styles from "./pastel-theme-lock.module.css";
+
+export function PastelThemeLock(): ReactNode {
+  return (
+    // `role="note"` + the aria-label give a screen-reader user the same
+    // explanation a sighted teacher gets from the replaced grid. Without it the
+    // picker would simply VANISH under this frame with no announced reason.
+    <div className={styles.lockedNote} role="note" aria-label="Theme locked">
+      Pastel locks its own palette — cool gray canvas, teal accents. Switch to
+      Calm Glass or Bright to use themes.
+    </div>
+  );
+}
