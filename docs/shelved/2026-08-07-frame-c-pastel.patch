@@ -0,0 +1,173 @@
+// tests/pastel-theme-lock-palette.test.ts
+//
+// The ⌘K command palette is the FOURTH global theme entry point, and the one
+// furthest from Settings: `setTheme(t.theme)` on eight rows, with no frame
+// check. A teacher on Frame C · Pastel — whose Settings page shows the locked
+// note in place of the theme grid — could still press ⌘K, type "night", and set
+// Night. The lock was decorative from the keyboard.
+//
+// Under Pastel the eight rows are REPLACED by one explanatory row that
+// navigates to Settings → Appearance (where the Frame control that unlocks
+// themes lives). Three properties are pinned, and the second and third are the
+// ones that distinguish this from the two shapes that would have been wrong:
+//
+//   • no theme row survives to be actionable                (not a no-op);
+//   • a theme-shaped query still finds SOMETHING            (not "No results");
+//   • the row does something real                           (it navigates).
+//
+// Stub set mirrors tests/command-palette-empty.test.ts — the palette's other
+// hooks are navigation and store plumbing with no bearing on this branch. The
+// theme module is spread from the original so only `useTheme` is swapped;
+// everything else its graph exports stays real.
+
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { createElement, createRef } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+
+import { CommandPaletteBody } from "@/components/shell/command-palette";
+import { mountReact } from "./mount-react";
+
+const store = vi.hoisted(() => ({
+  /** The axis under test. Drives which branch of the theme bucket renders. */
+  frame: "glass" as "glass" | "paper" | "color",
+  /** Captures router.push so "it navigates" is a fact, not an inference. */
+  pushed: [] as string[],
+}));
+
+vi.mock("@/lib/planner-store", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/planner-store")>()),
+  usePlanner: () => ({ lessons: [], subjects: [] }),
+  usePlannerDataState: () => "settled",
+}));
+vi.mock("next/navigation", () => ({
+  useRouter: () => ({
+    push: (href: string) => {
+      store.pushed.push(href);
+    },
+  }),
+}));
+vi.mock("@/lib/app-state", () => ({
+  useAppState: () => ({ setSubjectView: () => {}, setSearch: () => {} }),
+}));
+vi.mock("@/lib/theme", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/theme")>()),
+  useTheme: () => ({
+    theme: "clear",
+    resolvedTheme: "clear",
+    frame: store.frame,
+    glass: "dark",
+    bg: "photo",
+    dim: "normal",
+    tone: "light",
+    canvas: "glass-dim",
+    style: "calm",
+    palette: "normal",
+    setTheme: () => {},
+    setFrame: () => {},
+    setGlass: () => {},
+    setBg: () => {},
+    setDim: () => {},
+    setCanvas: () => {},
+    setStyle: () => {},
+    setPalette: () => {},
+  }),
+}));
+
+const DENIAL = "No results for";
+const LOCK_ROW = "Themes are locked by the Pastel frame";
+
+function render(query: string) {
+  return renderToStaticMarkup(
+    createElement(CommandPaletteBody, {
+      query,
+      onQueryChange: () => {},
+      onClose: () => {},
+      inputRef: createRef<HTMLInputElement>(),
+    }),
+  );
+}
+
+beforeEach(() => {
+  store.frame = "glass";
+  store.pushed = [];
+});
+
+describe("⌘K theme rows under Frame C · Pastel", () => {
+  it("offers NO theme row — the eight setTheme rows are gone", () => {
+    store.frame = "color";
+    const html = render("");
+    for (const label of [
+      "Theme: Clear",
+      "Theme: Night",
+      "Theme: Honey",
+      "Theme: Blossom",
+      "Theme: Mint",
+      "Theme: Sky",
+      "Theme: Off (Photo)",
+      "Theme: Follow system",
+    ])
+      expect(html, `${label} must not be offered on Pastel`).not.toContain(label);
+  });
+
+  it('answers a theme query with the explanation, not "No results"', () => {
+    // Filtering the rows to nothing would have been the lazy fix: a teacher who
+    // types "night" would be told, flatly, that no such thing exists. It does
+    // exist; it is unavailable HERE, for a reason, with a remedy.
+    store.frame = "color";
+    for (const query of ["night", "dark", "theme", "pastel", "honey", "sky"]) {
+      const html = render(query);
+      expect(html, `query "${query}"`).toContain(LOCK_ROW);
+      expect(html, `query "${query}"`).not.toContain(DENIAL);
+    }
+  });
+
+  it("the lock row is genuinely actionable — clicking it opens Appearance", async () => {
+    // The whole point of replacing rather than disabling: the row carries the
+    // teacher to the Frame control that unlocks themes. A row that looked
+    // actionable and did nothing would be the exact failure this repo has a
+    // standing ruling against — so this is a real mount and a real click, not a
+    // markup assertion that the row merely exists.
+    store.frame = "color";
+    const h = await mountReact(CommandPaletteBody);
+    try {
+      await h.render({
+        query: "night",
+        onQueryChange: () => {},
+        onClose: () => {},
+        inputRef: createRef<HTMLInputElement>(),
+      });
+      const row = h.query("#result-theme-locked-pastel");
+      expect(row, "the lock row must be in the mounted tree").not.toBeNull();
+      expect(store.pushed).toEqual([]);
+      await h.clickElement(row as Element);
+      expect(store.pushed).toEqual(["/settings/appearance"]);
+    } finally {
+      await h.unmount();
+    }
+  });
+
+  it("a non-theme query is unaffected by the lock", () => {
+    // The lock must not swallow the rest of the palette.
+    store.frame = "color";
+    const html = render("weekly");
+    expect(html).toContain("Weekly planner");
+    expect(html).not.toContain(LOCK_ROW);
+  });
+});
+
+describe("the lock is frame-scoped, not a blanket removal", () => {
+  it("Calm Glass still offers every theme row", () => {
+    store.frame = "glass";
+    const html = render("");
+    expect(html).toContain("Theme: Night");
+    expect(html).toContain("Theme: Clear");
+    expect(html).not.toContain(LOCK_ROW);
+  });
+
+  it("Bright (paper) still offers every theme row", () => {
+    store.frame = "paper";
+    const html = render("night");
+    expect(html).toContain("Theme: Night");
+    expect(html).not.toContain(LOCK_ROW);
+  });
+});
diff --git a/tests/pastel-theme-lock.test.ts b/tests/pastel-theme-lock.test.ts
