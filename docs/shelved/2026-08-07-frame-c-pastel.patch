+// tests/pastel-frame-css.test.ts
+//
+// Frame C · Pastel — the CSS contract.
+// ─────────────────────────────────────────────────────────────────────────────
+// The Pastel port re-points the semantic token tier (--surface, --border,
+// --muted, --ink, --ink-soft: ~2300 var() references between them), so two
+// things have to be true and neither is visible from reading a diff:
+//
+//   1. IT WINS. Every Pastel override competes with an existing rule — the dark
+//      tone tier for the neutrals, the Clear+Photo accent for --accent, the
+//      per-theme wash for .theme-tint. CSS resolves those by SPECIFICITY first
+//      and source order only on a tie. A rule that loses is not a subtle bug:
+//      it is invisible, and this repo has a documented history of exactly that
+//      (see docs — "CSS rules that die silently").
+//
+//   2. IT DOES NOT LEAK. A token re-point that escaped its frame scope would
+//      repaint Glass and Bright too.
+//
+// vitest runs in the node environment: there is no cascade and no layout here,
+// so this file reasons about SELECTOR TEXT and computes specificity itself. The
+// rendered consequence is measured separately by the live §4b pass. Both are
+// necessary; neither substitutes for the other.
+
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const read = (rel: string) =>
+  readFileSync(fileURLToPath(new URL(rel, import.meta.url)), "utf8");
+
+const TOKENS = read("../app/tokens.css");
+const THEMES = read("../app/themes.css");
+
+/** Blank out comments PRESERVING LENGTH so offsets still line up with the real
+ *  file. Both stylesheets name their own selectors in prose at length, and a
+ *  prose mention is not a rule — without this the Pastel banner comment alone
+ *  would register as a dozen phantom selectors. */
+const mask = (css: string) =>
+  css.replace(/\/\*[\s\S]*?\*\//g, (c) => c.replace(/[^\n]/g, " "));
+
+const TOKENS_M = mask(TOKENS);
+const THEMES_M = mask(THEMES);
+
+// ── Specificity ──────────────────────────────────────────────────────────────
+
+/**
+ * Compute (a,b,c) specificity for a SINGLE compound selector.
+ *   a = #id · b = .class | [attr] | :pseudo-class · c = element | ::pseudo-elem
+ * `:root` counts as a pseudo-class (b), which is the whole reason the doubled
+ * `[data-frame="color"][data-frame]` trick is needed: it buys one more `b`.
+ */
+function specificity(sel: string): [number, number, number] {
+  let s = sel.trim();
+  // :is()/:where() — :where() contributes ZERO; :is() takes its most specific
+  // argument. Neither appears in the rules under test, but a future edit could
+  // introduce one, and silently mis-scoring it would defeat the whole file.
+  if (/:where\(/.test(s)) s = s.replace(/:where\([^)]*\)/g, "");
+  if (/:is\(/.test(s)) {
+    // Score the most specific branch and splice it back in as a marker.
+    s = s.replace(/:is\(([^)]*)\)/g, (_m, inner: string) => {
+      const best = inner
+        .split(",")
+        .map((x) => specificity(x))
+        .sort((p, q) => q[0] - p[0] || q[1] - p[1] || q[2] - p[2])[0];
+      return "#".repeat(best[0]) + ".".repeat(best[1]) + "E".repeat(best[2]);
+    });
+  }
+  const ids = (s.match(/#[\w-]+/g) ?? []).length;
+  const attrs = (s.match(/\[[^\]]*\]/g) ?? []).length;
+  const classes = (s.replace(/\[[^\]]*\]/g, "").match(/\.[\w-]+/g) ?? []).length;
+  const pseudoEls = (s.match(/::[\w-]+/g) ?? []).length;
+  const pseudoCls = (
+    s.replace(/::[\w-]+/g, "").match(/:[\w-]+(\([^)]*\))?/g) ?? []
+  ).length;
+  const els = (
+    s
+      .replace(/\[[^\]]*\]/g, " ")
+      .replace(/::?[\w-]+(\([^)]*\))?/g, " ")
+      .replace(/[.#][\w-]+/g, " ")
+      .match(/\b[a-zA-Z][\w-]*\b/g) ?? []
+  ).length;
+  return [ids, attrs + classes + pseudoCls, pseudoEls + els];
+}
+
+const cmp = (x: [number, number, number], y: [number, number, number]) =>
+  x[0] - y[0] || x[1] - y[1] || x[2] - y[2];
+const fmt = (x: [number, number, number]) => `(${x[0]},${x[1]},${x[2]})`;
+
+// Sanity-check the instrument before trusting a single verdict from it. A
+// specificity calculator that silently returned [0,0,0] would make every
+// "Pastel wins" assertion below pass for the wrong reason.
+describe("the specificity calculator itself (instrument check)", () => {
+  it("scores the known reference selectors correctly", () => {
+    expect(specificity(":root")).toEqual([0, 1, 0]);
+    expect(specificity(':root[data-theme="clear"][data-bg="photo"]')).toEqual([
+      0, 3, 0,
+    ]);
+    expect(specificity(':root[data-frame="color"][data-frame]')).toEqual([
+      0, 3, 0,
+    ]);
+    expect(specificity(':root[data-tone="dark"]')).toEqual([0, 2, 0]);
+    expect(
+      specificity(':root[data-bg="photo"][data-theme="honey"] .theme-tint'),
+    ).toEqual([0, 4, 0]);
+    expect(specificity('[data-frame="color"] .card')).toEqual([0, 2, 0]);
+    // ...and that it can tell them apart in the direction the port relies on.
+    expect(
+      cmp(
+        specificity(':root[data-frame="color"][data-frame]'),
+        specificity(':root[data-tone="dark"]'),
+      ),
+    ).toBeGreaterThan(0);
+  });
+});
+
+// ── Rule extraction ──────────────────────────────────────────────────────────
+
+interface Rule {
+  selector: string;
+  index: number;
+  props: Set<string>;
+}
+
+/** Walk a stylesheet, recursing INTO at-rules — all of themes.css and the
+ *  tokens.css theme/tone tier live inside `@media screen`, so an at-rule-
+ *  skipping parser would find nothing at all here. */
+function readRules(text: string, start: number, end: number, out: Rule[]): void {
+  let i = start;
+  let preludeStart = start;
+  while (i < end) {
+    const ch = text[i];
+    if (ch === "{") {
+      const prelude = text.slice(preludeStart, i).trim();
+      let depth = 1;
+      let j = i + 1;
+      while (j < end && depth > 0) {
+        if (text[j] === "{") depth++;
+        else if (text[j] === "}") depth--;
+        j++;
+      }
+      if (prelude.startsWith("@")) {
+        readRules(text, i + 1, j - 1, out);
+      } else if (prelude) {
+        const props = new Set<string>();
+        for (const decl of text.slice(i + 1, j - 1).split(";")) {
+          const colon = decl.indexOf(":");
+          if (colon < 0) continue;
+          const name = decl.slice(0, colon).trim().toLowerCase();
+          if (/^-{0,2}[a-z][a-z0-9-]*$/.test(name)) props.add(name);
+        }
+        out.push({ selector: prelude, index: preludeStart, props });
+      }
+      i = j;
+      preludeStart = i;
+      continue;
+    }
+    if (ch === "}") {
+      i++;
+      preludeStart = i;
+      continue;
+    }
+    i++;
+  }
+}
+
+const parse = (masked: string) => {
+  const out: Rule[] = [];
+  readRules(masked, 0, masked.length, out);
+  return out;
+};
+
+const TOKEN_RULES = parse(TOKENS_M);
+const THEME_RULES = parse(THEMES_M);
+
+/** Every comma-separated arm of a rule, with its own specificity. */
+const arms = (r: Rule) => r.selector.split(",").map((s) => s.trim());
+
+/**
+ * Find the single rule whose selector list contains an exact arm. `prop`
+ * disambiguates when the same arm appears more than once — e.g.
+ * `:root[data-theme="clear"][data-bg="photo"]` is written twice in themes.css,
+ * once for --accent and once inside the reduced-motion guard. Requiring exactly
+ * one match is deliberate: a silent "first match wins" would let this file
+ * measure the wrong rule and report a green it had not earned.
+ */
+function ruleWithArm(rules: Rule[], arm: string, prop?: string): Rule {
+  let hit = rules.filter((r) => arms(r).includes(arm));
+  if (prop) hit = hit.filter((r) => r.props.has(prop));
+  if (hit.length !== 1)
+    throw new Error(
+      `expected exactly 1 rule with arm \`${arm}\`${prop ? ` declaring ${prop}` : ""}, found ${hit.length}`,
+    );
+  return hit[0];
+}
+
+/** The Pastel skin section of themes.css, bounded at both ends — from its banner
+ *  to the start of the next top-level section. Slicing to end-of-file instead
+ *  would drag in every later rule and make these assertions meaningless. */
+function pastelSkinSection(): string {
+  const start = THEMES.indexOf("FRAME C · PASTEL — the skin");
+  if (start < 0) throw new Error("Pastel skin banner not found in themes.css");
+  const rest = THEMES.slice(start);
+  // The next section banner is a line of ═ following a numbered heading.
+  const endRel = rest.indexOf("═══\n     3 · NIGHT TONE");
+  const nextBanner = rest.search(/\n {2,}\/\* ═{10,}\n {5}\d+ · /);
+  const end = endRel > 0 ? endRel : nextBanner > 0 ? nextBanner : rest.length;
+  return rest.slice(0, end);
+}
+
+/** Does `winner` beat `loser`? Specificity first, source order on a tie. */
+function beats(winner: Rule, loser: Rule, arm: string, loserArm: string) {
+  const w = specificity(arm);
+  const l = specificity(loserArm);
+  const bySpec = cmp(w, l);
+  return {
+    bySpec,
+    byOrder: winner.index - loser.index,
+    wins: bySpec > 0 || (bySpec === 0 && winner.index > loser.index),
+    detail: `${arm} ${fmt(w)} @${winner.index} vs ${loserArm} ${fmt(l)} @${loser.index}`,
+  };
+}
+
+// ── 1 · The token tier exists, is frame-scoped, and beats the dark tier ──────
+
+const PASTEL_ARM = ':root[data-frame="color"][data-frame]';
+
+describe("app/tokens.css — the Pastel token tier", () => {
+  const pastel = ruleWithArm(TOKEN_RULES, PASTEL_ARM);
+  const dark = ruleWithArm(TOKEN_RULES, ':root[data-tone="dark"]');
+
+  it("declares the handoff palette literals", () => {
+    for (const [tok, value] of [
+      ["--pastel-canvas", "#f1f5f9"],
+      ["--pastel-canvas-2", "#eef3f8"],
+      ["--pastel-surface", "#ffffff"],
+      ["--pastel-hairline", "#e4e4e7"],
+      ["--pastel-ink", "#09090b"],
+      ["--pastel-muted", "#52525c"],
+      ["--pastel-dim", "#9f9fa9"],
+      ["--pastel-slate", "#314158"],
+      ["--pastel-accent", "#007595"],
+      ["--pastel-accent-600", "#005f7a"],
+      ["--pastel-accent-50", "#d2eff4"],
+    ] as const) {
+      expect(pastel.props.has(tok), `${tok} declared`).toBe(true);
+      // The VALUE matters as much as the token: a typo'd hex would still parse.
+      const decl = new RegExp(`${tok}\\s*:\\s*${value}\\s*;`, "i");
+      expect(decl.test(TOKENS), `${tok} is ${value}`).toBe(true);
+    }
+  });
+
+  it("re-points the five high-traffic semantic tokens", () => {
+    for (const tok of [
+      "--surface",
+      "--border",
+      "--muted",
+      "--ink",
+      "--ink-soft",
+      "--canvas",
+      "--hairline",
+    ])
+      expect(pastel.props.has(tok), `${tok} re-pointed`).toBe(true);
+  });
+
+  it("BEATS the dark-tone tier — on specificity, not source order", () => {
+    const v = beats(pastel, dark, PASTEL_ARM, ':root[data-tone="dark"]');
+    expect(v.wins, v.detail).toBe(true);
+    // Specifically: it must win on SPECIFICITY. A source-order-only win is one
+    // reorder away from silent death, which is the failure this asserts against.
+    expect(v.bySpec, `must win on specificity alone — ${v.detail}`).toBeGreaterThan(
+      0,
+    );
+  });
+
+  it("re-orients the ink ramp to LIGHT (the dark tier inverts it)", () => {
+    // Without this, a stale data-tone="dark" would leave --ink-900 lightest
+    // under a white Pastel surface.
+    for (const tok of ["--ink-900", "--ink-500", "--ink-100", "--ink-50"])
+      expect(pastel.props.has(tok), `${tok} re-oriented`).toBe(true);
+    expect(/--ink-900:\s*#09090b/.test(TOKENS)).toBe(true);
+  });
+
+  it("sets all four type channels to Source Sans 3", () => {
+    for (const tok of [
+      "--font-sans",
+      "--font-display",
+      "--font-display-sm",
+      "--head-font",
+    ]) {
+      expect(pastel.props.has(tok), `${tok} set`).toBe(true);
+    }
+    const body = TOKENS.slice(TOKENS.indexOf(PASTEL_ARM));
+    expect(body).toContain("--font-source-sans");
+    // --font-logo is deliberately NOT re-pointed: the wordmark is brand
+    // identity, not a frame-skinnable channel.
+    expect(pastel.props.has("--font-logo")).toBe(false);
+  });
+
+  it("DOES NOT LEAK — every Pastel declaration is frame-scoped", () => {
+    const leaks = TOKEN_RULES.filter(
+      (r) =>
+        [...r.props].some((p) => p.startsWith("--pastel-")) &&
+        !arms(r).every((a) => a.includes('[data-frame="color"]')),
+    );
+    expect(leaks.map((r) => r.selector)).toEqual([]);
+  });
+});
+
+// ── 2 · The themes.css skin wins its three specificity fights ────────────────
+
+describe("app/themes.css — the Pastel skin overrides win", () => {
+  it("the teal accent beats the Clear+Photo accent", () => {
+    const pastel = ruleWithArm(THEME_RULES, PASTEL_ARM);
+    const clearPhoto = ruleWithArm(
+      THEME_RULES,
+      ':root[data-theme="clear"][data-bg="photo"]',
+      "--accent",
+    );
+    expect(pastel.props.has("--accent")).toBe(true);
+    expect(clearPhoto.props.has("--accent")).toBe(true);
+    const v = beats(
+      pastel,
+      clearPhoto,
+      PASTEL_ARM,
+      ':root[data-theme="clear"][data-bg="photo"]',
+    );
+    // Equal specificity (0,3,0) — this one is won on SOURCE ORDER, exactly as
+    // the handoff wins it. That is why --accent additionally carries
+    // !important here; assert both halves.
+    expect(v.wins, v.detail).toBe(true);
+    expect(v.byOrder, `must be later in the file — ${v.detail}`).toBeGreaterThan(
+      0,
+    );
+    const body = THEMES.slice(THEMES.indexOf(PASTEL_ARM));
+    expect(/--accent:\s*var\(--pastel-accent\)\s*!important/.test(body)).toBe(
+      true,
+    );
+  });
+
+  it("the .theme-tint kill beats the (0,4,0) per-theme photo rules", () => {
+    const arm = `${PASTEL_ARM} .theme-tint`;
+    const pastel = ruleWithArm(THEME_RULES, arm);
+    const honey = ruleWithArm(
+      THEME_RULES,
+      ':root[data-bg="photo"][data-theme="honey"] .theme-tint',
+    );
+    const v = beats(
+      pastel,
+      honey,
+      arm,
+      ':root[data-bg="photo"][data-theme="honey"] .theme-tint',
+    );
+    expect(v.wins, v.detail).toBe(true);
+    // (0,4,0) vs (0,4,0) + later + !important — belt, braces and a third strap.
+    expect(specificity(arm)).toEqual([0, 4, 0]);
+    expect(/\.theme-tint\s*\{\s*opacity:\s*0\s*!important/.test(THEMES)).toBe(
+      true,
+    );
+  });
+
+  it("the Pastel .card beats the legacy Frame-C .card on specificity alone", () => {
+    const arm = `${PASTEL_ARM} .card`;
+    const pastel = ruleWithArm(THEME_RULES, arm);
+    const legacy = ruleWithArm(THEME_RULES, '[data-frame="color"] .card');
+    const v = beats(pastel, legacy, arm, '[data-frame="color"] .card');
+    expect(v.wins, v.detail).toBe(true);
+    expect(v.bySpec, v.detail).toBeGreaterThan(0);
+  });
+
+  it("the colour·Night rules are GONE — they are unreachable and were a hazard", () => {
+    // deriveTone rule 0 makes [data-tone="dark"][data-frame="color"] impossible.
+    // Leaving these would have painted near-black panels under near-black ink if
+    // the derivation ever regressed.
+    const survivors = THEME_RULES.filter((r) =>
+      arms(r).some(
+        (a) => a.includes('[data-tone="dark"]') && a.includes('[data-frame="color"]'),
+      ),
+    );
+    expect(survivors.map((r) => r.selector)).toEqual([]);
+  });
+
+  it("uses NO raw hex — every Pastel colour comes through a token", () => {
+    // CLAUDE.md §4: colours live in tokens.css. The skin may reference
+    // var(--pastel-*) but must not restate a literal.
+    const section = mask(pastelSkinSection());
+    const hexes = section.match(/#[0-9a-fA-F]{3,8}\b/g) ?? [];
+    // #fff on the active-tab foreground is the one allowed literal: it is not a
+    // palette colour but the "text on a solid accent" contrast pair, which the
+    // handoff also writes literally (pastel-frame.css:44).
+    expect(hexes.filter((h) => h.toLowerCase() !== "#fff")).toEqual([]);
+  });
+});
+
+// ── 3 · Radii — RULE #1, no sharp corners ───────────────────────────────────
+
+describe("RULE #1 — Pastel introduces no sharp corners", () => {
+  it("uses --r-pill rather than the handoff's literal 9999px", () => {
+    const section = pastelSkinSection();
+    expect(section).toContain("border-radius: var(--r-pill)");
+    // Mask comments first: the section's own prose CITES the handoff's literal
+    // ("--r-pill rather than the handoff's literal 9999px"), and matching that
+    // would fail the rule the comment exists to document.
+    const code = mask(section);
+    expect(code).not.toContain("9999px");
+    // ...and never sets a zero/sharp radius anywhere in the Pastel skin.
+    expect(/border-radius:\s*0\b/.test(code)).toBe(false);
+  });
+});
diff --git a/tests/pastel-theme-lock-entry-points.test.ts b/tests/pastel-theme-lock-entry-points.test.ts
new file mode 100644
index 0000000..ee271dd
--- /dev/null
+++ b/tests/pastel-theme-lock-entry-points.test.ts
@@ -0,0 +1,196 @@
+// tests/pastel-theme-lock-entry-points.test.ts
+//
+// Frame C · Pastel LOCKS its own palette (7.21 handoff). tests/pastel-theme-
+// lock.test.ts pins the TWO full pickers. This file exists because pinning two
+// of four surfaces is what let the lock ship bypassable: `theme-quick-switch`
+// (the ⋯ More menu + the Settings sidebar) and the ⌘K command palette both
+// still called setTheme() with no frame check, so a teacher on Pastel could set
+// Night from either while Settings → Appearance told them themes were
+// unavailable.
+//
+// Two different kinds of assertion live here, and the first is the one that
+// keeps this from happening a third time:
+//
+//   1 · THE CENSUS. Enumerate every setTheme() call site in app/ · components/
+//       · lib/ and require the set to equal a reviewed allowlist, each member
+//       of which must itself carry the frame check. A NEW global theme entry
+//       point therefore fails this file the moment it is written, whether or
+//       not anyone remembered the lock. A per-surface behavioural test can
+//       only ever cover surfaces someone thought of.
+//
+//   2 · THE BEHAVIOUR of the quick-switch itself, at all three frames.
+//       (The palette's behaviour needs the store/router stubs, so it lives in
+//       tests/pastel-theme-lock-palette.test.ts.)
+//
+// The census FAILS CLOSED by construction: a broken scan yields an empty set,
+// which cannot equal the non-empty allowlist. That matters — this repo's
+// costliest bug class is a check that reports a pass it did not earn.
+//
+// Deliberately a .ts file using createElement rather than .tsx with JSX: the
+// suite's include glob is `tests/**/*.test.ts`, so a .tsx file would sit in the
+// tree looking like coverage while never being collected.
+
+import { describe, it, expect } from "vitest";
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { renderToStaticMarkup } from "react-dom/server";
+import { createElement } from "react";
+
+import { ThemeProvider } from "@/lib/theme";
+import type { ThemeFrame } from "@/lib/theme";
+import { ThemeQuickSwitch } from "@/components/appearance/theme-quick-switch";
+
+const REPO = fileURLToPath(new URL("..", import.meta.url));
+const abs = (rel: string) => fileURLToPath(new URL(`../${rel}`, import.meta.url));
+
+// ── 1 · The census ───────────────────────────────────────────────────────────
+
+/**
+ * Every file, outside the provider itself, that can change the app-wide theme
+ * value. Adding a surface here is a deliberate act; the assertions below then
+ * require that surface to honour the Pastel lock.
+ *
+ * `lib/theme.tsx` is excluded from the scan (not allowlisted) because it is the
+ * DECLARATION site: its setTheme is the useState setter, driven by persistence,
+ * the cross-tab `storage` event and the theme-sync remote apply. Those are not
+ * teacher-facing controls and must keep landing the persisted value under every
+ * frame — Pastel hides the theme, it does not erase it, exactly as the two full
+ * pickers already behave (leave Pastel and the previous theme returns).
+ */
+const THEME_ENTRY_POINTS: readonly string[] = [
+  "components/appearance/appearance-controls.tsx",
+  "components/appearance/theme-picker.tsx",
+  "components/appearance/theme-quick-switch.tsx",
+  "components/shell/command-palette.tsx",
+];
+
+/** The provider — scanned over, never allowlisted. See the note above. */
+const PROVIDER = "lib/theme.tsx";
+
+const SCAN_ROOTS = ["app", "components", "lib"] as const;
+
+function walk(dir: string, out: string[]): void {
+  for (const name of readdirSync(dir)) {
+    if (name === "node_modules" || name === ".next") continue;
+    const full = `${dir}/${name}`;
+    if (statSync(full).isDirectory()) walk(full, out);
+    else if (/\.tsx?$/.test(name)) out.push(full);
+  }
+}
+
+/** Repo-relative, forward-slashed paths of files that call setTheme(...). */
+function findSetThemeCallSites(): string[] {
+  const files: string[] = [];
+  for (const root of SCAN_ROOTS) walk(abs(root), files);
+  const hits: string[] = [];
+  for (const file of files) {
+    const src = readFileSync(file, "utf8");
+    // A CALL, not a mention: `setTheme(` / `setTheme (`. Destructuring
+    // (`const { setTheme } = useTheme()`), the interface member and prose all
+    // fail this, so a file that merely names the setter is not a call site.
+    if (/\bsetTheme\s*\(/.test(src)) {
+      hits.push(file.slice(REPO.length).replace(/\\/g, "/"));
+    }
+  }
+  return hits.sort();
+}
+
+describe("the census of global theme entry points", () => {
+  const found = findSetThemeCallSites();
+
+  it("finds call sites at all (instrument check — this scan must not fail open)", () => {
+    // A scan that silently matched nothing would make every assertion below
+    // pass while checking nothing. The provider is the one call site we know
+    // exists unconditionally, so its presence proves the walker reached the
+    // tree and the pattern matches real code.
+    expect(found).toContain(PROVIDER);
+    expect(found.length).toBeGreaterThan(1);
+  });
+
+  it("is exactly the reviewed allowlist — a NEW entry point fails here", () => {
+    // The failure this file exists for. If you are reading this because the
+    // test just went red: a file gained the ability to change the theme.
+    // Give it the Pastel lock (replace its control with <PastelThemeLock /> or
+    // the palette's equivalent explanatory row — never a silent no-op), then
+    // add it to THEME_ENTRY_POINTS.
+    expect(found.filter((f) => f !== PROVIDER)).toEqual([...THEME_ENTRY_POINTS].sort());
+  });
+
+  it("every allowlisted entry point actually carries the frame check", () => {
+    // Allowlisting without locking would turn the census into a rubber stamp.
+    for (const rel of THEME_ENTRY_POINTS) {
+      const src = readFileSync(abs(rel), "utf8");
+      expect(/frame\s*===\s*"color"/.test(src), `${rel} branches on the Pastel frame`).toBe(
+        true,
+      );
+      // ...and reads `frame` off the theme context rather than inferring it.
+      expect(/\bframe\b/.test(src), `${rel} reads the frame axis`).toBe(true);
+    }
+  });
+});
+
+// ── 2 · The quick-switch behaviour ───────────────────────────────────────────
+
+/** The handoff's locked-note copy, verbatim (settings.jsx:186). */
+const LOCK_COPY =
+  "Pastel locks its own palette — cool gray canvas, teal accents. Switch to Calm Glass or Bright to use themes.";
+
+function renderAt(frame: ThemeFrame, menuSemantics: boolean): string {
+  return renderToStaticMarkup(
+    createElement(ThemeProvider, {
+      initialFrame: frame,
+      children: createElement(ThemeQuickSwitch, { menuSemantics }),
+    }),
+  );
+}
+
+const text = (html: string) =>
+  html
+    .replace(/<[^>]+>/g, " ")
+    .replace(/&#x27;/g, "'")
+    .replace(/&quot;/g, '"')
+    .replace(/&amp;/g, "&")
+    .replace(/&#(\d+);/g, (_m, d) => String.fromCharCode(Number(d)))
+    .replace(/\s+/g, " ")
+    .trim();
+
+describe("ThemeQuickSwitch — the ⋯ More menu + Settings sidebar chips", () => {
+  it("Pastel (color) in the More menu: chips REPLACED by the locked note", () => {
+    const html = renderAt("color", true);
+    expect(text(html)).toContain(LOCK_COPY);
+    // Replaced, not hidden and not disabled-in-place: nothing that looks
+    // actionable survives. `menuitemradio` is the specific control a teacher
+    // could still click on Pastel before this fix.
+    expect(html).not.toContain('role="menuitemradio"');
+    expect(html).not.toContain('role="radio"');
+    expect(html).not.toContain('aria-label="Theme quick switch"');
+    // Announced, not silently swapped in.
+    expect(html).toContain('role="note"');
+    expect(html).toContain('aria-label="Theme locked"');
+  });
+
+  it("Pastel (color) in the Settings sidebar: same treatment", () => {
+    const html = renderAt("color", false);
+    expect(text(html)).toContain(LOCK_COPY);
+    expect(html).not.toContain('role="radiogroup"');
+    expect(html).not.toContain('role="radio"');
+  });
+
+  it("Calm Glass: the chips are present and the note is absent", () => {
+    // The opposite failure, and the likelier one after a fix like this: a lock
+    // that fires everywhere would pass every assertion above while removing the
+    // quick-switch from the two frames that are supposed to have it.
+    const html = renderAt("glass", false);
+    expect(text(html)).not.toContain("Pastel locks its own palette");
+    expect(html).toContain('role="radiogroup"');
+    expect(html).toContain('aria-label="Theme quick switch"');
+    for (const label of ["Clear theme", "Night theme", "Honey theme"])
+      expect(html).toContain(label);
+  });
+
+  it("Bright (paper): unchanged — the lock is frame-scoped, not a blanket off", () => {
+    const html = renderAt("paper", true);
+    expect(text(html)).not.toContain("Pastel locks its own palette");
+    expect(html).toContain('role="menuitemradio"');
+  });
+});
