index 0000000..d7c8dd6
--- /dev/null
+++ b/tests/pastel-theme-lock.test.ts
@@ -0,0 +1,150 @@
+// tests/pastel-theme-lock.test.ts
+//
+// Frame C · Pastel LOCKS its own palette (7.21 handoff): under this frame the
+// 7-theme picker is REPLACED by an explanatory note, not merely disabled
+// (source-home/settings.jsx:185-187).
+//
+// There are TWO separate theme choosers in this app, and /settings/appearance
+// mounts BOTH — `<AppearanceControls />` (its "theme" axis group) and the
+// standalone `<ThemePicker />`. A lock applied to only one of them would leave a
+// live, fully-functional theme grid sitting directly beneath the note telling
+// the teacher themes are unavailable. This file pins BOTH, which is the whole
+// reason it exists as a separate test rather than a line in another one.
+//
+// Rendered with react-dom/server rather than a DOM harness: these are pure,
+// props-driven branches with no effects to settle, so static markup is the
+// cheapest complete evidence. (react-dom/server does work in this repo's node
+// vitest environment, despite older comments to the contrary.)
+//
+// Deliberately a .ts file using createElement rather than .tsx with JSX: the
+// suite's include glob is `tests/**/*.test.ts`, so a .tsx file is silently NOT
+// COLLECTED — it would sit in the tree looking like coverage while never once
+// running. Renaming was the right fix; widening the shared glob was not mine to
+// make, and would have been a larger change than this file warrants.
+
+import { describe, it, expect } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { createElement } from "react";
+import type { ReactElement } from "react";
+
+import { ThemeProvider } from "@/lib/theme";
+import type { ThemeFrame } from "@/lib/theme";
+import { AppearanceControls } from "@/components/appearance/appearance-controls";
+import { ThemePicker } from "@/components/appearance/theme-picker";
+
+/** The handoff's locked-note copy, verbatim (settings.jsx:186). */
+const LOCK_COPY =
+  "Pastel locks its own palette — cool gray canvas, teal accents. Switch to Calm Glass or Bright to use themes.";
+
+function renderAt(frame: ThemeFrame, node: ReactElement): string {
+  // `children` goes in the props object rather than as a positional third
+  // argument: ThemeProviderProps declares it REQUIRED, and the positional form
+  // does not satisfy that for the type-checker.
+  return renderToStaticMarkup(
+    createElement(ThemeProvider, { initialFrame: frame, children: node }),
+  );
+}
+
+// Normalise the HTML entities react emits for the em dash / non-breaking
+// punctuation so a copy comparison is about WORDS, not encoding.
+const text = (html: string) =>
+  html
+    .replace(/<[^>]+>/g, " ")
+    .replace(/&#x27;/g, "'")
+    .replace(/&quot;/g, '"')
+    .replace(/&amp;/g, "&")
+    .replace(/&#(\d+);/g, (_m, d) => String.fromCharCode(Number(d)))
+    .replace(/\s+/g, " ")
+    .trim();
+
+describe("AppearanceControls — the theme axis under each frame", () => {
+  it("Pastel (color): the theme grid is REPLACED by the locked note", () => {
+    const html = renderAt(
+      "color",
+      createElement(AppearanceControls, { axes: ["theme"] }),
+    );
+    expect(text(html)).toContain(LOCK_COPY);
+    // Replaced, not merely hidden or disabled: no theme radio survives.
+    expect(html).not.toContain('aria-label="Theme"');
+    expect(html).not.toContain('role="radiogroup"');
+    expect(html).not.toContain('role="radio"');
+  });
+
+  it("Calm Glass: the theme grid is present and the note is absent", () => {
+    const html = renderAt(
+      "glass",
+      createElement(AppearanceControls, { axes: ["theme"] }),
+    );
+    expect(text(html)).not.toContain("Pastel locks its own palette");
+    expect(html).toContain('role="radiogroup"');
+    // The seven concrete themes are all offered.
+    for (const label of ["Clear", "Night", "Honey", "Blossom", "Mint", "Sky"])
+      expect(text(html)).toContain(label);
+  });
+
+  it("Bright (paper): unchanged — the lock is frame-scoped, not a blanket off", () => {
+    const html = renderAt(
+      "paper",
+      createElement(AppearanceControls, { axes: ["theme"] }),
+    );
+    expect(text(html)).not.toContain("Pastel locks its own palette");
+    expect(html).toContain('role="radiogroup"');
+  });
+});
+
+describe("ThemePicker — the OTHER chooser, mounted alongside on /settings/appearance", () => {
+  it("Pastel (color): replaced by the same locked note", () => {
+    const html = renderAt("color", createElement(ThemePicker));
+    expect(text(html)).toContain(LOCK_COPY);
+    expect(html).not.toContain('role="radiogroup"');
+    expect(html).not.toContain('role="radio"');
+  });
+
+  it("Calm Glass: the full picker renders, including Follow system", () => {
+    const html = renderAt("glass", createElement(ThemePicker));
+    expect(text(html)).not.toContain("Pastel locks its own palette");
+    expect(html).toContain('role="radiogroup"');
+    expect(text(html)).toContain("Clear");
+  });
+});
+
+describe("the locked note is announced, not silently swapped in", () => {
+  it("carries a note role so a screen reader gets the explanation too", () => {
+    const html = renderAt(
+      "color",
+      createElement(AppearanceControls, { axes: ["theme"] }),
+    );
+    // Without this the grid would simply vanish for a screen-reader user with
+    // no announced reason.
+    expect(html).toContain('role="note"');
+    expect(html).toContain('aria-label="Theme locked"');
+  });
+});
+
+describe("the frame picker advertises Pastel by its handoff name", () => {
+  it("labels frame C 'Pastel · Soft tints · Common Planner', not 'Color'", () => {
+    const html = renderAt(
+      "glass",
+      createElement(AppearanceControls, { axes: ["frame"] }),
+    );
+    const t = text(html);
+    expect(t).toContain("Pastel");
+    expect(t).toContain("Soft tints");
+    expect(t).toContain("Common Planner");
+    // The pre-handoff copy must be gone.
+    expect(t).not.toContain("Subject-led");
+    // "Color" must not survive as a standalone frame LABEL. (It may still occur
+    // inside longer prose such as tooltips, so match the label form.)
+    expect(t).not.toMatch(/\bColor Subject-led\b/);
+  });
+
+  it("renders a preview swatch for every frame (there was none before)", () => {
+    const html = renderAt(
+      "glass",
+      createElement(AppearanceControls, { axes: ["frame"] }),
+    );
+    // Three decorative swatches, one per frame option.
+    const swatches = html.match(/aria-hidden="true"/g) ?? [];
+    expect(swatches.length).toBeGreaterThanOrEqual(3);
+  });
+});
diff --git a/tests/pastel-theme-tier-isolation.test.ts b/tests/pastel-theme-tier-isolation.test.ts
new file mode 100644
index 0000000..cf8aec3
--- /dev/null
+++ b/tests/pastel-theme-tier-isolation.test.ts
@@ -0,0 +1,434 @@
+// tests/pastel-theme-tier-isolation.test.ts
+//
+// FRAME C · PASTEL MUST NOT WEAR ANOTHER THEME'S TOKENS.
+// ─────────────────────────────────────────────────────────────────────────────
+// `deriveTone()` rule 0 forces tone="light" whenever frame==="color", and the
+// theme picker is replaced by a locked note under Pastel. Neither of those stops
+// a theme that is ALREADY PERSISTED: lib/theme.tsx paints `data-theme` onto
+// <html> under every frame, so
+//
+//     <html data-theme="night" data-frame="color" data-tone="light">
+//
+// is reachable exactly as the boot script's own comment describes — a teacher
+// with Night saved who then selects Pastel. app/tokens.css's biggest dark rule
+// is a two-arm union, `:root[data-tone="dark"], :root[data-theme="night"]`, and
+// only the FIRST arm is disarmed by the tone derivation. The second kept firing:
+// 117 declared tokens against the Pastel tier's 62, so ~82 bled through —
+// including every --subj-N-ink / --tag-*-fg (written as a mix toward `white`,
+// i.e. near-invisible on Pastel's white cards) and the hard-dark --brand-50/100/
+// 200, --honey-50/100, --grad-*.
+//
+// WHAT THIS FILE IS, AND WHAT IT IS NOT.
+// A selector-text assertion ("the rule contains :not(...)") is not sufficient
+// evidence — it passes on a typo'd qualifier, on a rule that was never reachable
+// anyway, and on a fix that scopes one tier while a sibling still bleeds. So the
+// bulk of this file SIMULATES THE CASCADE for :root-scoped custom properties:
+// it parses app/tokens.css, matches each rule against a concrete <html>
+// attribute vector, resolves each token to the rule that actually wins
+// (specificity, then source order), and asserts WHOSE declaration that is.
+//
+// vitest runs `environment: "node"` — there is no real style engine here. The
+// rendered consequence is measured separately, in a browser, by the §4b live
+// pass (real getComputedStyle under data-theme="night" + data-frame="color").
+// Both are necessary; neither substitutes for the other.
+//
+// THE MATCHER IS ITSELF UNDER TEST (first describe block). An absence-assertion
+// over a broken matcher is the fail-open shape this repo keeps getting bitten
+// by: a matcher that matched nothing would pass every "no theme tier applies"
+// assertion below while checking nothing at all. The Glass+Night control proves
+// the tier is visible to the instrument before any Pastel absence is claimed.
+
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const TOKENS = readFileSync(
+  fileURLToPath(new URL("../app/tokens.css", import.meta.url)),
+  "utf8",
+);
+
+/** Blank comments PRESERVING LENGTH so source offsets still order correctly.
+ *  tokens.css names its own selectors in prose at length; without this the
+ *  banner comments alone would register as a dozen phantom rules. */
+const mask = (css: string) =>
+  css.replace(/\/\*[\s\S]*?\*\//g, (c) => c.replace(/[^\n]/g, " "));
+
+// ── Rule extraction ──────────────────────────────────────────────────────────
+
+interface Rule {
+  selector: string;
+  /** Source offset — the tiebreak when specificity is equal. */
+  index: number;
+  /** Custom properties this rule declares (names only). */
+  props: Set<string>;
+  /** Names declared with !important. */
+  important: Set<string>;
+}
+
+/** Walk a stylesheet, recursing INTO at-rules — the whole theme/tone tier lives
+ *  inside `@media screen`, so an at-rule-skipping parser finds nothing here. */
+function readRules(text: string, start: number, end: number, out: Rule[]): void {
+  let i = start;
+  let preludeStart = start;
+  while (i < end) {
+    const ch = text[i];
+    if (ch === "{") {
+      const prelude = text.slice(preludeStart, i).trim();
+      let depth = 1;
+      let j = i + 1;
+      while (j < end && depth > 0) {
+        if (text[j] === "{") depth++;
+        else if (text[j] === "}") depth--;
+        j++;
+      }
+      if (prelude.startsWith("@")) {
+        readRules(text, i + 1, j - 1, out);
+      } else if (prelude) {
+        const props = new Set<string>();
+        const important = new Set<string>();
+        for (const decl of text.slice(i + 1, j - 1).split(";")) {
+          const colon = decl.indexOf(":");
+          if (colon < 0) continue;
+          const name = decl.slice(0, colon).trim();
+          if (!/^--[\w-]+$/.test(name)) continue;
+          props.add(name);
+          if (/!\s*important/i.test(decl.slice(colon))) important.add(name);
+        }
+        out.push({ selector: prelude, index: preludeStart, props, important });
+      }
+      i = j;
+      preludeStart = i;
+      continue;
+    }
+    if (ch === "}") {
+      i++;
+      preludeStart = i;
+      continue;
+    }
+    i++;
+  }
+}
+
+const RULES: Rule[] = [];
+readRules(mask(TOKENS), 0, TOKENS.length, RULES);
+
+/** Every comma-separated arm of a rule. */
+const arms = (r: Rule) => r.selector.split(",").map((s) => s.trim());
+
+// ── A tiny :root-compound matcher ────────────────────────────────────────────
+//
+// Deliberately NARROW. It understands exactly the shape the token tiers use —
+// `:root` followed by attribute selectors and `:not(<attribute selectors>)` —
+// and returns null for ANYTHING ELSE (descendant combinators, classes,
+// elements, other pseudo-classes). Null means "this instrument cannot judge
+// that arm", never "it does not match": a matcher that guessed would be the
+// silent-wrong-answer failure this file exists to prevent.
+
+/** The <html> attributes of one concrete appearance state. */
+type RootAttrs = Record<string, string>;
+
+function matchRootArm(arm: string, attrs: RootAttrs): boolean | null {
+  let s = arm.trim();
+  if (!s.startsWith(":root")) return null;
+  s = s.slice(":root".length);
+  while (s.length > 0) {
+    if (s.startsWith(":not(")) {
+      const close = s.indexOf(")");
+      if (close < 0) return null;
+      const inner = matchRootArm(`:root${s.slice(5, close)}`, attrs);
+      if (inner === null) return null;
+      if (inner) return false;
+      s = s.slice(close + 1);
+      continue;
+    }
+    if (s.startsWith("[")) {
+      const close = s.indexOf("]");
+      if (close < 0) return null;
+      const body = s.slice(1, close);
+      const m = /^([a-zA-Z][\w-]*)(?:="([^"]*)")?$/.exec(body);
+      if (!m) return null;
+      const [, name, value] = m;
+      const present = Object.prototype.hasOwnProperty.call(attrs, name);
+      if (value === undefined) {
+        if (!present) return false;
+      } else if (attrs[name] !== value) {
+        return false;
+      }
+      s = s.slice(close + 1);
+      continue;
+    }
+    return null;
+  }
+  return true;
+}
+
+/** (a,b,c) specificity for one bare :root compound. `:not()` contributes its
+ *  argument's specificity (the argument here is always a single attribute). */
+function specificity(arm: string): [number, number, number] {
+  const attrs = (arm.match(/\[[^\]]*\]/g) ?? []).length;
+  // `:root` plus any `:not(` — :not() itself adds nothing, its argument does
+  // (already counted above as an attribute).
+  const pseudo = (arm.match(/:root\b/g) ?? []).length;
+  return [0, attrs + pseudo, 0];
+}
+
+const cmp = (x: [number, number, number], y: [number, number, number]) =>
+  x[0] - y[0] || x[1] - y[1] || x[2] - y[2];
+
+interface Match {
+  rule: Rule;
+  arm: string;
+  spec: [number, number, number];
+}
+
+/** Every rule that applies to <html> in this state, with its winning arm. */
+function matchingRules(attrs: RootAttrs): Match[] {
+  const out: Match[] = [];
+  for (const rule of RULES) {
+    let best: Match | null = null;
+    for (const arm of arms(rule)) {
+      if (matchRootArm(arm, attrs) !== true) continue;
+      const spec = specificity(arm);
+      if (!best || cmp(spec, best.spec) > 0) best = { rule, arm, spec };
+    }
+    if (best) out.push(best);
+  }
+  return out;
+}
+
+/** Which rule's declaration of `token` actually paints, in this state?
+ *  !important first, then specificity, then source order. */
+function winnerFor(token: string, attrs: RootAttrs): Match | null {
+  const candidates = matchingRules(attrs).filter((m) => m.rule.props.has(token));
+  if (candidates.length === 0) return null;
+  return candidates.reduce((a, b) => {
+    const ai = a.rule.important.has(token) ? 1 : 0;
+    const bi = b.rule.important.has(token) ? 1 : 0;
+    if (ai !== bi) return bi > ai ? b : a;
+    const s = cmp(b.spec, a.spec);
+    if (s !== 0) return s > 0 ? b : a;
+    return b.rule.index > a.rule.index ? b : a;
+  });
+}
+
+// ── The two states under test ────────────────────────────────────────────────
+//
+// PASTEL_NIGHT is the reachable state the bug lives in. GLASS_NIGHT is the
+// control: the same persisted theme on a frame that is SUPPOSED to wear it.
+
+const PASTEL_NIGHT: RootAttrs = {
+  "data-frame": "color",
+  "data-theme": "night",
+  // Forced by deriveTone rule 0 — Pastel is light-only.
+  "data-tone": "light",
+  "data-bg": "photo",
+  "data-dim": "normal",
+  "data-glass": "dark",
+};
+
+const GLASS_NIGHT: RootAttrs = {
+  "data-frame": "glass",
+  "data-theme": "night",
+  "data-tone": "dark",
+  "data-bg": "photo",
+  "data-dim": "normal",
+  "data-glass": "dark",
+};
+
+/** One name from every token family the review named as bleeding. */
+const SAMPLE = [
+  "--subj-1-ink",
+  "--subj-1-tint",
+  "--subj-10-ink",
+  "--subj-15-tint",
+  "--tag-pink-bg",
+  "--tag-pink-fg",
+  "--tag-gray-fg",
+  "--accent",
+  "--chrome-accent",
+  "--mesh-a",
+  "--grad-hero",
+  "--honey-50",
+  "--brand-50",
+  "--brand-700",
+  "--warn-tint",
+  "--danger-tint",
+  "--urgent-bg",
+  "--important-bg",
+  "--logo-book-b",
+] as const;
+
+// ── 0 · The instrument, before any verdict is trusted ────────────────────────
+
+describe("the matcher itself (instrument check — this must not fail open)", () => {
+  it("parses a non-trivial number of rules out of tokens.css", () => {
+    expect(RULES.length).toBeGreaterThan(20);
+  });
+
+  it("understands attribute presence, value and :not()", () => {
+    const a: RootAttrs = { "data-frame": "color", "data-theme": "night" };
+    expect(matchRootArm(":root", a)).toBe(true);
+    expect(matchRootArm(':root[data-theme="night"]', a)).toBe(true);
+    expect(matchRootArm(':root[data-theme="mint"]', a)).toBe(false);
+    expect(matchRootArm(':root[data-frame="color"][data-frame]', a)).toBe(true);
+    expect(
+      matchRootArm(':root[data-theme="night"]:not([data-frame="color"])', a),
+    ).toBe(false);
+    expect(matchRootArm(':root[data-tone="dark"]', a)).toBe(false);
+    // Absent attribute: `:not()` on it MATCHES (the v1 flag-OFF DOM emits no
+    // data-frame at all, and must keep its dark tier).
+    expect(
+      matchRootArm(':root[data-theme="night"]:not([data-frame="color"])', {
+        "data-theme": "night",
+      }),
+    ).toBe(true);
+    // Shapes it must refuse to judge rather than guess at.
+    expect(matchRootArm(':root[data-frame="color"] .card', a)).toBeNull();
+    expect(matchRootArm(".home", a)).toBeNull();
+  });
+
+  it("scores specificity in the direction the port relies on", () => {
+    expect(specificity(":root")).toEqual([0, 1, 0]);
+    expect(specificity(':root[data-theme="night"]')).toEqual([0, 2, 0]);
+    expect(specificity(':root[data-frame="color"][data-frame]')).toEqual([0, 3, 0]);
+    expect(
+      specificity(':root[data-theme="night"]:not([data-frame="color"])'),
+    ).toEqual([0, 3, 0]);
+  });
+
+  // THE CONTROL. Every Pastel absence-assertion below is meaningless unless the
+  // night tier is visible to this instrument in the state that SHOULD have it.
+  it("CONTROL — under Glass+Night the night tier wins every sampled token", () => {
+    // Keyed on the winning RULE, not the winning ARM, and that distinction was
+    // found the hard way: the dark block is `:root[data-tone="dark"],
+    // :root[data-theme="night"]…`, so which ARM the matcher reports for it
+    // depends on a specificity tie-break between its own two arms. An
+    // arm-keyed control passed only because the fix happens to lift the night
+    // arm to (0,3,0) — it went red under the mutation test for a reason that
+    // had nothing to do with tier visibility, which is precisely the false
+    // signal a control must not produce. The rule is what carries the tokens.
+    const themed = matchingRules(GLASS_NIGHT).filter((m) =>
+      m.rule.selector.includes('[data-theme="night"]'),
+    );
+    expect(themed.length).toBeGreaterThan(0);
+    const fromNight = SAMPLE.filter((t) => {
+      const w = winnerFor(t, GLASS_NIGHT);
+      return w !== null && w.rule.selector.includes('[data-theme="night"]');
+    });
+    // Not all 19 live in the night tiers, but most do; a handful (e.g. tokens
+    // only the tone block declares) legitimately come from elsewhere. Requiring
+    // a solid majority keeps this a real control without pinning the tier's
+    // exact contents.
+    expect(fromNight.length).toBeGreaterThanOrEqual(10);
+  });
+});
+
+// ── 1 · The invariant, at source level ───────────────────────────────────────
+
+describe("every [data-theme] tier in tokens.css is frame-scoped", () => {
+  it("no bare :root theme arm is left unqualified", () => {
+    const unqualified = RULES.flatMap((r) => arms(r)).filter(
+      (arm) =>
+        /^:root(\[[^\]]*\]|:not\([^)]*\))*$/.test(arm) &&
+        arm.includes("[data-theme=") &&
+        !arm.includes(':not([data-frame="color"])'),
+    );
+    // If this went red: a theme tier was added or edited without the qualifier,
+    // and it now paints its tokens underneath the Pastel skin. Add
+    // `:not([data-frame="color"])` to the arm.
+    expect(unqualified).toEqual([]);
+  });
+
+  it("the dark-tone arm is NOT qualified — tone is the correct key there", () => {
+    // The other direction. Qualifying the tone arm too would be harmless today
+    // (tone can't be dark under Pastel) but would muddy the contract: dark is
+    // keyed on tone, and the frame carve-out belongs only on the legacy
+    // theme-keyed compat arm.
+    const toneArm = RULES.flatMap((r) => arms(r)).filter(
+      (a) => a === ':root[data-tone="dark"]',
+    );
+    expect(toneArm).toEqual([':root[data-tone="dark"]']);
+  });
+});
+
+// ── 2 · The invariant, resolved through the cascade ──────────────────────────
+
+describe("under data-frame=color no theme tier reaches <html>", () => {
+  it("no matching rule is keyed on data-theme", () => {
+    const themed = matchingRules(PASTEL_NIGHT).filter((m) =>
+      m.arm.includes("[data-theme="),
+    );
+    expect(themed.map((m) => m.arm)).toEqual([]);
+  });
+
+  it("every sampled token resolves to :root or to the Pastel tier", () => {
+    for (const token of SAMPLE) {
+      const w = winnerFor(token, PASTEL_NIGHT);
+      expect(w, `${token} must still be declared somewhere`).not.toBeNull();
+      expect(
+        (w as Match).arm,
+        `${token} resolves from ${(w as Match).arm}`,
+      ).not.toContain("[data-theme=");
+    }
+  });
+
+  it("the fix leaves NOTHING undefined — every night token still resolves", () => {
+    // The failure mode of a scoping fix: a token declared ONLY by the tier you
+    // just disarmed becomes unset under Pastel, and every var() reading it
+    // falls back to its (often absent) default. Assert the opposite.
+    const nightTokens = new Set<string>();
+    for (const rule of RULES)
+      if (arms(rule).some((a) => a.includes('[data-theme="night"]')))
+        for (const p of rule.props) nightTokens.add(p);
+    expect(nightTokens.size).toBeGreaterThan(100);
+
+    const orphans = [...nightTokens].filter(
+      (t) => winnerFor(t, PASTEL_NIGHT) === null,
+    );
+    expect(orphans).toEqual([]);
+  });
+
+  it("the Pastel tier still owns the neutrals it is supposed to own", () => {
+    // The over-reach direction: a scoping change that also knocked out Pastel's
+    // own tier would pass every assertion above.
+    for (const token of [
+      "--surface",
+      "--canvas",
+      "--border",
+      "--muted",
+      "--ink",
+      "--ink-900",
+      "--ink-50",
+    ]) {
+      const w = winnerFor(token, PASTEL_NIGHT);
+      expect(w, `${token} declared`).not.toBeNull();
+      expect((w as Match).arm, `${token} comes from the Pastel tier`).toContain(
+        '[data-frame="color"]',
+      );
+    }
+  });
+});
+
+// ── 3 · The lock is frame-scoped, not a blanket theme kill ───────────────────
+
+describe("themes still work on the frames that have them", () => {
+  it("Glass+Night still gets the full dark neutral tier", () => {
+    for (const token of ["--surface", "--canvas", "--ink-900"]) {
+      const w = winnerFor(token, GLASS_NIGHT);
+      expect(w, `${token} declared`).not.toBeNull();
+      const arm = (w as Match).arm;
+      expect(
+        arm === ':root[data-tone="dark"]' ||
+          arm.includes('[data-theme="night"]'),
+        `${token} comes from the dark tier, got ${arm}`,
+      ).toBe(true);
+    }
+  });
+
+  it("Glass+Mint still gets the mint tier", () => {
+    const mint: RootAttrs = { ...GLASS_NIGHT, "data-theme": "mint", "data-tone": "light" };
+    const w = winnerFor("--logo-book-b", mint);
+    expect(w).not.toBeNull();
+    expect((w as Match).arm).toContain('[data-theme="mint"]');
+  });
+});
diff --git a/tests/theme-tone-lockstep.test.ts b/tests/theme-tone-lockstep.test.ts
